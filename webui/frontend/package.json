{
  "name": "astrbot-media-portal-webui",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Media Portal WebUI — Vite + Vue 3 + TypeScript + Pinia + vue-router + vue-i18n (Bun powered)",
  "packageManager": "bun@1.1.38",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,vue}\"",
    "format": "prettier --write \"src/**/*.{ts,vue,css,json}\""
  },
  "dependencies": {
    "lucide-vue-next": "^0.460.0",
    "pinia": "^2.2.6",
    "plyr": "^3.8.4",
    "vue": "^3.5.13",
    "vue-i18n": "^9.14.2",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^4.0.0",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "eslint": "^9.15.0",
    "eslint-plugin-vue": "^9.31.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vue-tsc": "^2.1.10"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "trustedDependencies": [
    "esbuild",
    "vue-demi"
  ]
}
